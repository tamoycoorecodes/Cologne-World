@model CologneWorld.Models.Product
@{ ViewData["Title"] = "Edit Product"; }
<div class="container py-5"><div class="row justify-content-center"><div class="col-lg-8"><div class="product-card p-4"><h1 class="mb-4">Edit Product</h1><form asp-action="Edit" asp-route-id="@Model.ProductId" method="post"><input asp-for="ProductId" type="hidden" /><partial name="_ProductForm" model="Model" /><button class="btn btn-primary-custom" type="submit">Save Changes</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
