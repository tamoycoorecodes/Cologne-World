@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<div class="container py-5"><div class="row justify-content-center"><div class="col-lg-7"><div class="product-card p-5 text-center"><i class="fas fa-triangle-exclamation fa-3x text-warning mb-3"></i><h1>Something went wrong</h1><p class="text-muted">We could not complete your request. Please try again. If the problem continues, contact the store administrator.</p>@if (Model.ShowRequestId) { <p class="small text-muted">Reference: <code>@Model.RequestId</code></p> }<a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom">Return to Home</a></div></div></div></div>
